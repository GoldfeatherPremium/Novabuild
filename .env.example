# ==========================================================================
# NOVA — environment configuration
# Copy to .env.local and fill in real values. Never commit real secrets.
# The app detects missing config and surfaces a clear "integration status"
# instead of pretending the feature works.
# ==========================================================================

# --- Supabase (required for accounts, database, storage) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- AI provider (provider-independent layer, OpenAI-compatible) -----------
# AI_PROVIDER: openai-compatible | none
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_SUMMARY_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Billing (Stripe test mode until production keys are configured) ------
# BILLING_PROVIDER: stripe | none
BILLING_PROVIDER=none
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_PRICE_PRO_MONTHLY=
BILLING_PRICE_PRO_YEARLY=
BILLING_PRICE_TEAM_MONTHLY=
BILLING_PRICE_TEAM_YEARLY=

# --- Email (transactional) ------------------------------------------------
# EMAIL_PROVIDER: resend | none
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=NOVA <no-reply@example.com>

# --- App -------------------------------------------------------------------
# Public URL used in emails and auth redirects (no trailing slash)
APP_URL=http://localhost:3000
# 32-byte hex key used to encrypt sensitive stored values (e.g. OAuth state)
ENCRYPTION_KEY=
